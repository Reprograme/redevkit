{
  // REDEVKIT markdownlint configuration
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD036": false,
    "MD041": false,
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", "test/fixtures/**", "e2e/fixtures/**", "test/__snapshots__/**", "e2e/runs/**", "CHANGELOG.md", "PLANO.md", "RELATORIO.md"]
}
